# Rust / Cargo
/target/
**/target/
Cargo.lock.orig

# Cloudflare workers-rs build output (worker-build)
/worker/build/
/worker/.wrangler/

# wasm-bindgen / wasm-pack output
/pkg/
*.wasm

# Secrets and local env. Real values only via GitHub Secrets or `wrangler secret`.
.env
.env.*
!.env.example

# Evidencia de scripts/verify_repo.py: es un artefacto generado, se sube como
# artifact de CI. Versionarlo seria evidencia que nadie regenera y por tanto
# solo puede quedarse vieja.
/verification_evidence.json

# Python (scripts/verify_repo.py corre en CI, no se byte-compila en el repo)
__pycache__/
*.pyc

# Editors / OS
.DS_Store
*.swp
.idea/
.vscode/

# NOTE: legacy/ is intentionally tracked. It is an archive, not dead build output.